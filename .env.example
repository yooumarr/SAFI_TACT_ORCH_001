# Copy to .env and replace each placeholder locally. .env is gitignored.
GENERIC_TIMEZONE=Asia/Kolkata
WINDMILL_DB_PASSWORD=replace-with-long-random-password
GATE_API_TOKEN=replace-with-long-random-token
# Example only: map test actor GUIDs to allowed test ConversationIDs.
GATE_ACTORS_JSON={}
# Must point to an authenticated trusted dispatcher that honors idempotency keys.
DISPATCH_URL=
N8N_API_KEY=replace-with-api-key-from-local-n8n-settings
N8N_MARKETING_WORKFLOW_ID=replace-with-imported-workflow-id
N8N_ACTOR_GUID=replace-with-test-actor-guid
CALNODE_API_KEY=replace-with-local-calnode-api-key
CALNODE_EVENT_TYPE_SLUG=test-intro-call
WINDMILL_WORKSPACE=admins
WINDMILL_TOKEN=replace-with-local-windmill-workspace-token
