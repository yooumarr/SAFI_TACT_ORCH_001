  "nodes": [
    {
      "id": "marketing-intake-webhook",
      "name": "Consented lead intake",
      "webhookId": "safi-marketing-intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        304
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "safi/marketing-intake",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "require-consent-and-allowlist",
      "name": "Require explicit consent and allowlist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        304
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "consent-check",
              "leftValue": "={{ $json.body.action.payload.consent }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "allowlist-check",
              "leftValue": "={{ $json.body.action.payload.allowlisted }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "prepare-consented-follow-up",
      "name": "Prepare approved follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        224
      ],
      "parameters": {
        "jsCode": "const action = $input.first().json.body.action; return [{ json: { status: \"prepared\", leadId: action.payload.lead?.id ?? \"test-lead\", conversationId: action.conversationId, operationId: action.operationId } }];"
      }
    },
    {
      "id": "report-test-execution",
      "name": "Report test execution",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1440,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: $json.status ?? \"captured\", leadId: $(\"Consented lead intake\").first().json.body.action.payload.lead?.id ?? \"test-lead\", conversationId: $(\"Consented lead intake\").first().json.body.action.conversationId, operationId: $(\"Consented lead intake\").first().json.body.action.operationId, executionId: $execution.id, mailbox: \"Mailpit\" }) }}",
        "options": {}
      }
    },
    {
      "id": "reject-unconsented",
      "name": "Reject without contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        416
      ],
      "parameters": {
        "jsCode": "return [{ json: { status: \"blocked\", reason: \"consent and allowlist are required\" } }];"
      }
    },
    {
      "id": "capture-test-follow-up",
      "name": "Capture follow-up in local Mailpit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "http://mailpit:8025/api/v1/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { From: { Email: \"orchestration@example.invalid\", Name: \"Safi Test\" }, To: [{ Email: $(\"Consented lead intake\").first().json.body.action.payload.recipient, Name: $(\"Consented lead intake\").first().json.body.action.payload.lead?.name ?? \"Test lead\" }], Subject: $(\"Consented lead intake\").first().json.body.action.payload.subject ?? \"Your inquiry follow-up\", Text: $(\"Consented lead intake\").first().json.body.action.payload.message ?? \"Thanks for your test inquiry.\" } }}",
        "options": {
          "timeout": 10000
        }
      }
    }
  ],
